From 5091129f25a0108237ec7dd053e3b8610c382176 Mon Sep 17 00:00:00 2001
From: Redux Deep Research <redux@invalid>
Date: Fri, 20 Nov 2026 03:01:07 -0500
Subject: [PATCH 4/5] dt-bindings: display: panel: add Anbernic RG34XX-SP v2
 panel

Later Anbernic RG34XX-SP handhelds (board strap PE6 high) carry a
second 3.4" 720x480 IPS panel. Its register sequence is that of a
GalaxyCore GC9703 controller; like the original panel it is configured
over 3-wire SPI and fed by a 24-bit parallel RGB bus. Add a binding for
it next to the one for the original panel.

The controller was identified from the register sequence in the vendor
firmware (GC9703 command-set enable and page layout), not from a
marking on the part.

The maintainer line is a placeholder until a person takes it.

This patch was drafted with an AI coding assistant (Claude) and checked
with dt_binding_check. It has not been tested on hardware.
---
 .../panel/anbernic,rg34xx-sp-v2-panel.yaml    | 66 +++++++++++++++++++
 1 file changed, 66 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/anbernic,rg34xx-sp-v2-panel.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/anbernic,rg34xx-sp-v2-panel.yaml b/Documentation/devicetree/bindings/display/panel/anbernic,rg34xx-sp-v2-panel.yaml
new file mode 100644
index 000000000..8c8aabd74
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/anbernic,rg34xx-sp-v2-panel.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/anbernic,rg34xx-sp-v2-panel.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Anbernic RG34XX-SP 3.4" 720x480 24-bit IPS LCD panel, second version
+
+description:
+  The panel of later Anbernic RG34XX-SP handhelds (board strap PE6 high). It
+  has a GalaxyCore GC9703 controller, set up over 3-wire SPI, and takes pixel
+  data over a 24-bit parallel RGB bus. The original panel of this handheld is
+  described in anbernic,rg34xx-sp-panel.yaml.
+
+maintainers:
+  - Redux Kernel Research <redux@invalid>
+
+allOf:
+  - $ref: panel-common.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: anbernic,rg34xx-sp-v2-panel
+
+  reg:
+    maxItems: 1
+
+  spi-3wire: true
+
+required:
+  - compatible
+  - reg
+  - port
+  - power-supply
+  - reset-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "anbernic,rg34xx-sp-v2-panel";
+            reg = <0>;
+
+            spi-3wire;
+            spi-max-frequency = <3125000>;
+
+            reset-gpios = <&pio 8 14 GPIO_ACTIVE_LOW>; // PI14
+
+            backlight = <&backlight>;
+            power-supply = <&reg_lcd>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&tcon_lcd0_out_lcd>;
+                };
+            };
+        };
+    };
-- 

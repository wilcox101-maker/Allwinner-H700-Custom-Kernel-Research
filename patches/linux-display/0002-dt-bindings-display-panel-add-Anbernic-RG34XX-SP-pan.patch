From 0cf017ecbb61b6c145181748c5be630ba892032b Mon Sep 17 00:00:00 2001
From: Redux Kernel Research <redux@invalid>
Date: Sat, 14 Nov 2026 06:50:47 -0500
Subject: [PATCH 2/3] dt-bindings: display: panel: add Anbernic RG34XX-SP panel

The Anbernic RG34XX-SP handheld has a 3.4" 720x480 IPS panel with a
NewVision NV3052C controller, configured over 3-wire SPI and fed by a
24-bit parallel RGB bus. Add a binding for it, following the one for
the RG35XX family panels on the same controller.

This applies to the original panel only (the board's PE6 strap reads
low). Later units with PE6 high carry a different panel whose
controller is not identified yet; it is not covered here.

The maintainer line is a placeholder until a person takes it.

This patch was drafted with an AI coding assistant (Claude) and checked
with dt_binding_check. It has not been tested on hardware.
---
 .../panel/anbernic,rg34xx-sp-panel.yaml       | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/anbernic,rg34xx-sp-panel.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/anbernic,rg34xx-sp-panel.yaml b/Documentation/devicetree/bindings/display/panel/anbernic,rg34xx-sp-panel.yaml
new file mode 100644
index 000000000..958da2c67
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/anbernic,rg34xx-sp-panel.yaml
@@ -0,0 +1,65 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/anbernic,rg34xx-sp-panel.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Anbernic RG34XX-SP 3.4" 720x480 24-bit IPS LCD panel
+
+description:
+  The panel of the Anbernic RG34XX-SP handheld (original panel; board strap
+  PE6 low). It has a NewVision NV3052C controller, set up over 3-wire SPI,
+  and takes pixel data over a 24-bit parallel RGB bus.
+
+maintainers:
+  - Redux Kernel Research <redux@invalid>
+
+allOf:
+  - $ref: panel-common.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: anbernic,rg34xx-sp-panel
+
+  reg:
+    maxItems: 1
+
+  spi-3wire: true
+
+required:
+  - compatible
+  - reg
+  - port
+  - power-supply
+  - reset-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "anbernic,rg34xx-sp-panel";
+            reg = <0>;
+
+            spi-3wire;
+            spi-max-frequency = <3125000>;
+
+            reset-gpios = <&pio 8 14 GPIO_ACTIVE_LOW>; // PI14
+
+            backlight = <&backlight>;
+            power-supply = <&reg_lcd>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&tcon_lcd0_out_lcd>;
+                };
+            };
+        };
+    };
-- 

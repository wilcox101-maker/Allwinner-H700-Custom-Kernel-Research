+
+static inline struct gc9703 *to_gc9703(struct drm_panel *panel)
+{
+	return container_of(panel, struct gc9703, panel);
+}
+
+static int gc9703_send_init(struct gc9703 *priv)
+{
+	const u8 *init = priv->panel_info->init;
+	unsigned int len = priv->panel_info->init_len;
+	unsigned int i = 0;
+	int err;
+
+	while (i < len) {
+		unsigned int num_params = init[i];
+
+		if (i + 2 + num_params > len) {
+			dev_err(priv->dev, "Malformed init sequence at offset %u\n", i);
+			return -EINVAL;
+		}
+
+		err = mipi_dbi_command_stackbuf(&priv->dbi, init[i + 1],
+						&init[i + 2], num_params);
+		if (err) {
+			dev_err(priv->dev, "Unable to send command %#04x: %d\n",
+				init[i + 1], err);
+			return err;
+		}
+
+		i += 2 + num_params;
+	}
+
+	return 0;
+}
+
+static int gc9703_prepare(struct drm_panel *panel)
+{
+	struct gc9703 *priv = to_gc9703(panel);
+	int err;
+
+	err = regulator_enable(priv->supply);
+	if (err) {
+		dev_err(priv->dev, "Failed to enable power supply: %d\n", err);
+		return err;
+	}
+
+	/* Reset the chip */
+	gpiod_set_value_cansleep(priv->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(priv->reset_gpio, 0);
+	msleep(50);
+
+	err = gc9703_send_init(priv);
+	if (err)
+		goto err_disable_regulator;
+
+	err = mipi_dbi_command(&priv->dbi, MIPI_DCS_EXIT_SLEEP_MODE);
+	if (err) {
+		dev_err(priv->dev, "Unable to exit sleep mode: %d\n", err);
+		goto err_disable_regulator;
+	}
+
+	msleep(120);
+
+	return 0;
+
+err_disable_regulator:
+	gpiod_set_value_cansleep(priv->reset_gpio, 1);
+	regulator_disable(priv->supply);
+	return err;
+}
+
+static int gc9703_unprepare(struct drm_panel *panel)
+{
+	struct gc9703 *priv = to_gc9703(panel);
+	int err;
+
+	err = mipi_dbi_command(&priv->dbi, MIPI_DCS_ENTER_SLEEP_MODE);
+	if (err)
+		dev_err(priv->dev, "Unable to enter sleep mode: %d\n", err);
+
+	msleep(120);
+
+	gpiod_set_value_cansleep(priv->reset_gpio, 1);
+	regulator_disable(priv->supply);
+
+	return 0;
+}
+
+static int gc9703_enable(struct drm_panel *panel)
+{
+	struct gc9703 *priv = to_gc9703(panel);
+	int err;
+
+	err = mipi_dbi_command(&priv->dbi, MIPI_DCS_SET_DISPLAY_ON);
+	if (err) {
+		dev_err(priv->dev, "Unable to enable display: %d\n", err);
+		return err;
+	}
+
+	/* Let the first frames settle before the backlight comes on */
+	if (panel->backlight)
+		msleep(120);
+
+	return 0;
+}
+
+static int gc9703_disable(struct drm_panel *panel)
+{
+	struct gc9703 *priv = to_gc9703(panel);
+	int err;
+
+	err = mipi_dbi_command(&priv->dbi, MIPI_DCS_SET_DISPLAY_OFF);
+	if (err) {
+		dev_err(priv->dev, "Unable to disable display: %d\n", err);
+		return err;
+	}
+
+	return 0;
+}
+
+static int gc9703_get_modes(struct drm_panel *panel,
+			    struct drm_connector *connector)
+{
+	struct gc9703 *priv = to_gc9703(panel);
+	const struct gc9703_panel_info *panel_info = priv->panel_info;
+	struct drm_display_mode *mode;
+	unsigned int i;
+
+	for (i = 0; i < panel_info->num_modes; i++) {
+		mode = drm_mode_duplicate(connector->dev,
+					  &panel_info->display_modes[i]);
+		if (!mode)
+			return -ENOMEM;
+
+		drm_mode_set_name(mode);
+
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (panel_info->num_modes == 1)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.bpc = 8;
+	connector->display_info.width_mm = panel_info->width_mm;
+	connector->display_info.height_mm = panel_info->height_mm;
+
+	drm_display_info_set_bus_formats(&connector->display_info,
+					 &panel_info->bus_format, 1);
+	connector->display_info.bus_flags = panel_info->bus_flags;
+
+	return panel_info->num_modes;
+}
+
+static const struct drm_panel_funcs gc9703_funcs = {
+	.prepare	= gc9703_prepare,
+	.unprepare	= gc9703_unprepare,
+	.enable		= gc9703_enable,
+	.disable	= gc9703_disable,
+	.get_modes	= gc9703_get_modes,
+};
+
+static int gc9703_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct gc9703 *priv;
+	int err;
+
+	priv = devm_drm_panel_alloc(dev, struct gc9703, panel, &gc9703_funcs,
+				    DRM_MODE_CONNECTOR_DPI);
+	if (IS_ERR(priv))
+		return PTR_ERR(priv);
+
+	priv->dev = dev;
+
+	priv->panel_info = of_device_get_match_data(dev);
+	if (!priv->panel_info)
+		return -EINVAL;
+
+	priv->supply = devm_regulator_get(dev, "power");
+	if (IS_ERR(priv->supply))
+		return dev_err_probe(dev, PTR_ERR(priv->supply), "Failed to get power supply\n");
+
+	priv->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(priv->reset_gpio), "Failed to get reset GPIO\n");
+
+	err = mipi_dbi_spi_init(spi, &priv->dbi, NULL);
+	if (err)
+		return dev_err_probe(dev, err, "MIPI DBI init failed\n");
+
+	priv->dbi.read_commands = NULL;
+
+	spi_set_drvdata(spi, priv);
+
+	err = drm_panel_of_backlight(&priv->panel);
+	if (err)
+		return dev_err_probe(dev, err, "Failed to attach backlight\n");
+
+	drm_panel_add(&priv->panel);
+
+	return 0;
+}
+
+static void gc9703_remove(struct spi_device *spi)
+{
+	struct gc9703 *priv = spi_get_drvdata(spi);
+
+	drm_panel_remove(&priv->panel);
+	drm_panel_disable(&priv->panel);
+	drm_panel_unprepare(&priv->panel);
+}

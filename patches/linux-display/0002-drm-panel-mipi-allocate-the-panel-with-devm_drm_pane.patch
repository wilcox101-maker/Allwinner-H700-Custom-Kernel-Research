From 80dd34042684a743c4c782475ef2c7b3f1a77b21 Mon Sep 17 00:00:00 2001
From: Redux Kernel Research <redux@invalid>
Date: Sat, 14 Nov 2026 03:08:35 -0500
Subject: [PATCH] drm: panel: mipi: allocate the panel with
 devm_drm_panel_alloc()

drm_panel_init() was removed from mainline once every panel driver had
moved to devm_drm_panel_alloc(), which allocates the driver structure
and initialises the refcounted drm_panel in one step. The generic MIPI
panel driver (v2, posted 2025-02-26) predates that and no longer
builds. Allocate with devm_drm_panel_alloc() instead.

Also reject DSI pixel formats the driver has no bus format for, such
as MIPI_DSI_FMT_RGB101010 added since, instead of probing with an
unset bus format (and a -Wswitch warning).

This is a fix-up for an unmerged series and would be folded into its
next version rather than sent on its own.

This patch was drafted with an AI coding assistant (Claude) and checked
by building with W=1 (arm64, gcc 13.3.0). It has not been tested on
hardware.
---
 drivers/gpu/drm/panel/panel-mipi.c | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-mipi.c b/drivers/gpu/drm/panel/panel-mipi.c
index a4da1fd2e..533a8e0e2 100644
--- a/drivers/gpu/drm/panel/panel-mipi.c
+++ b/drivers/gpu/drm/panel/panel-mipi.c
@@ -973,9 +973,10 @@ static int panel_mipi_probe(struct device *dev, int connector_type)
 	struct panel_mipi *mipi;
 	int err;
 
-	mipi = devm_kzalloc(dev, sizeof(*mipi), GFP_KERNEL);
-	if (!mipi)
-		return -ENOMEM;
+	mipi = devm_drm_panel_alloc(dev, struct panel_mipi, panel,
+				    &panel_mipi_funcs, connector_type);
+	if (IS_ERR(mipi))
+		return PTR_ERR(mipi);
 
 	mutex_init(&mipi->lock);
 
@@ -1013,9 +1014,6 @@ static int panel_mipi_probe(struct device *dev, int connector_type)
 	if (err)
 		return err;
 
-	/* DRM panel setup */
-	drm_panel_init(&mipi->panel, dev, &panel_mipi_funcs, connector_type);
-
 	err = panel_mipi_set_backlight(&mipi->panel, dev, mipi);
 	if (err)
 		return dev_err_probe(dev, err, "Failed to set backlight\n");
@@ -1066,6 +1064,10 @@ static int panel_mipi_dsi_probe(struct mipi_dsi_device *dsi)
 	case MIPI_DSI_FMT_RGB565:
 		mipi->bus_format = MEDIA_BUS_FMT_RGB565_1X16;
 		break;
+	default:
+		return dev_err_probe(&dsi->dev, -EINVAL,
+				     "Unsupported DSI pixel format %d\n",
+				     dsi->format);
 	}
 
 	err = mipi_dsi_attach(dsi);
-- 

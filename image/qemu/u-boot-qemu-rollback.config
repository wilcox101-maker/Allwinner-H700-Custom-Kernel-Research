# SPDX-License-Identifier: GPL-2.0-only
# u-boot qemu_arm64_defconfig + this fragment (merge_config.sh) = the u-boot used by rollback-test.sh.
# ENV_SIZE matches sunxi (0x10000) so fw_env.config is the same as on the device.
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_ENV_IS_IN_FAT=y
# CONFIG_ENV_IS_IN_FLASH is not set
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_FAT_INTERFACE="virtio"
CONFIG_ENV_FAT_DEVICE_AND_PART="0:1"
CONFIG_ENV_FAT_FILE="uboot.env"
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv kernel_comp_addr_r 0x48000000; setenv kernel_comp_size 0x4000000; setenv bootlimit 3; setenv altbootcmd 'echo R8: boot limit reached, booting fallback; setenv upgrade_available 0; setenv bootcount 0; setenv fallback_used 1; saveenv; virtio scan; sysboot virtio 0:1 fat ${scriptaddr} /extlinux/extlinux-fallback.conf'; if env exists upgrade_available; then; else setenv upgrade_available 0; setenv bootcount 0; saveenv; fi"
CONFIG_CMD_SYSBOOT=y
CONFIG_ENV_SIZE=0x10000

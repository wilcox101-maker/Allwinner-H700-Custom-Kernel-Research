/*
 * Anbernic RG34XX-SP, Redux tree with the REVISED (v2) panel (PE6 strap high on V1.0.6-era
 * units). Firmware: panels/anbernic,rg34xx-sp-v2-panel.panel (gen_panel_firmware.py --panel v2,
 * from a V1.0.6 stock image only). Not selected by default until a v2 unit confirms PE6 = 1
 * (device task K9, decision Q3). DRAFT, NOT BOOTED.
 */

#include "sun50i-h700-anbernic-rg34xx-sp-redux.dts"
#include "sun50i-h700-redux-display.dtsi"

&redux_panel {
	compatible = "anbernic,rg34xx-sp-v2-panel", "panel-mipi-dpi-spi";
};

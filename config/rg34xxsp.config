# Kernel config fragment: Anbernic RG34XX-SP (Allwinner H700), Ubuntu 24.04 userspace.
# Applied on top of arm64 defconfig by scripts/build-kernel.sh, after a generated fragment that
# turns off every other ARCH_* platform. Base: torvalds/linux 97d73c8 + patches/linux/0001-0006.
# DRAFT, NOT BOOTED. Every option below says where the need comes from.

## Reproducible name: kernel release = <version>-rg34xxsp, with no git hash of the local
## patch commits (those change with every git am).
# CONFIG_LOCALVERSION_AUTO is not set

## Trim: this SoC has no PCIe, no ACPI firmware, and a handheld does not host virtual machines.
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set

## Board drivers missing from defconfig. Found by tools/dt_driver_coverage.py on the redux DTB:
## each enabled node with no driver in defconfig.
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_ADC=m
CONFIG_IIO_MUX=m
CONFIG_SUN20I_GPADC=m
CONFIG_SND_SUN4I_CODEC=m
CONFIG_AXP20X_ADC=m
CONFIG_AXP20X_POWER=m
CONFIG_BATTERY_AXP20X=m
CONFIG_SUN50I_IOMMU=y
CONFIG_SUN50I_H6_PRCM_PPU=y
# Video engine (Cedrus, staging; needs V4L2). Hardware decode for media players, optional.
CONFIG_MEDIA_SUPPORT=m
CONFIG_VIDEO_SUNXI=y
CONFIG_VIDEO_SUNXI_CEDRUS=m

## Input: the frontend reads evdev; joydev for older SDL/emulator paths.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=m

## Wi-Fi and Bluetooth, RTL8821CS (board DT: rtw88 on mmc1, BT on UART1). R4 audit: modules,
## firmware from noble's linux-firmware-realtek, which ships .zst files. No EXTRA_FIRMWARE (R9).
CONFIG_RTW88=m
CONFIG_RTW88_8821CS=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_RTL=m
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

## Memory: zram swap for the 512 MB tier (R5: noble's virtual kernel lacked zram.ko).
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

## systemd v255 (noble) README "REQUIREMENTS" (tag v255, db11bab): required options.
CONFIG_DEVTMPFS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_FHANDLE=y
# CONFIG_SYSFS_DEPRECATED is not set
# CONFIG_UEVENT_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
## Same README, optional features we want: automount, sandboxing, systemd-oomd (PSI), cgroup BPF.
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PSI=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
# Not in the v255 list; kept because device ACLs (logind "uaccess") on /dev need it [inferred].
CONFIG_TMPFS_POSIX_ACL=y

## Boot and storage: FAT /boot (extlinux) and ext4 root on microSD.
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EXT4_FS=y

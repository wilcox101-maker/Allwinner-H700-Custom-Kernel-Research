# SPDX-License-Identifier: GPL-2.0-only
# u-boot config fragment for the RG34XX-SP (task R1), merged onto mainline u-boot's
# anbernic_rg35xx_h700_defconfig by scripts/build-uboot.sh. DRAFT, NOT BOOTED.
# The defconfig already gives: H616 SPL with LPDDR4 @ 672 MHz, AXP717 (DCDC2 0.94 V GPU/sys rail,
# DCDC3 1.10 V DRAM), environment in FAT (uboot.env, 64 KiB) on the boot device's FAT partition.

## Device tree by panel ID (patches/u-boot/0001; PE6 low -> -redux-panel.dtb, high -> -redux.dtb)
CONFIG_ANBERNIC_RG34XXSP_DT_SELECTION=y

## Kernel rollback (task R8, docs/r8-update-rollback.md section 2): count boots only while
## upgrade_available=1; after 3 failed tries boot the fallback menu.
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv bootlimit 3; setenv altbootcmd 'echo R8: boot limit reached, booting fallback; setenv upgrade_available 0; setenv bootcount 0; setenv fallback_used 1; saveenv; sysboot mmc 0:1 fat ${scriptaddr} /extlinux/extlinux-fallback.conf'; if env exists upgrade_available; then; else setenv upgrade_available 0; setenv bootcount 0; saveenv; fi"
CONFIG_CMD_SYSBOOT=y

## Version string "2026.10-rg34xxsp", without git hash or "-dirty" (reproducible builds)
CONFIG_LOCALVERSION="-rg34xxsp"
# CONFIG_LOCALVERSION_AUTO is not set

# Kernel config fragment for the display layer (task R19), merged after rg34xxsp.config by
# scripts/build-kernel.sh --display. These options exist only once patches/upstream/
# display-layer.txt is applied, so they are kept out of the base fragment.
# DRAFT, NOT BOOTED. Every option says where the need comes from.

## H616 PWM controller (series 1202273): backlight on PWM0 / PD28.
CONFIG_PWM_SUN8I=m
CONFIG_BACKLIGHT_PWM=m

## Panel set-up over bit-banged SPI (PI8/PI9/PI10) and the generic MIPI DPI+SPI panel driver
## (series 937983), which loads panels/<compatible>.panel from the firmware directory.
CONFIG_SPI_GPIO=m
CONFIG_DRM_PANEL_MIPI=m

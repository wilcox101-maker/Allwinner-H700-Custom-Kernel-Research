# Kernel config fragment for the display layer (task R19), merged after rg34xxsp.config by
# scripts/build-kernel.sh --display. The PWM option exists only once patches/upstream/
# display-layer.txt is applied, so these are kept out of the base fragment.
# DRAFT, NOT BOOTED. Every option says where the need comes from.

## H616 PWM controller (series 1202273): backlight on PWM0 / PD28.
CONFIG_PWM_SUN8I=m
CONFIG_BACKLIGHT_PWM=m

## Panel set-up over bit-banged SPI (PI8/PI9/PI10); NV3052C panel driver with our RG34XX-SP
## entry (patches/linux-display/, decision Q8).
CONFIG_SPI_GPIO=m
CONFIG_DRM_PANEL_NEWVISION_NV3052C=m

## Newer panel (PE6 high, GC9703 family; patches/linux-display/0004-0005). Opt-in tree only
## (-redux-v2-panel.dtb, never selected by our u-boot); the module costs nothing when unused.
CONFIG_DRM_PANEL_GALAXYCORE_GC9703=m
